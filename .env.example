# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
# Use hex values for passwords (they go into connection URLs).

# Public address. Every tenant lives under this one host: https://pm.lockred.app/<tenant>
APP_HOST=pm.lockred.app
APP_URL=https://pm.lockred.app

# Traefik (must match your Traefik static config)
TRAEFIK_ENTRYPOINT=websecure
# Name of your certificatesResolvers entry. Leave empty if Traefik serves a default/wildcard certificate.
TRAEFIK_CERTRESOLVER=

# Database
DB_OWNER_PASSWORD=change-me-hex
DB_APP_PASSWORD=change-me-hex-too

# Secret used to sign internal tokens and hash IPs
APP_SECRET=change-me-long-random-hex

# First operator account (created on first start if no operator exists).
# You must set up 2-step sign-in on first login.
OPERATOR_EMAIL=you@lockred.app
OPERATOR_PASSWORD=change-me-strong-password
# Where new support requests are announced
OPS_NOTIFY_EMAIL=support@lockred.app

# Email (SMTP). If SMTP_HOST is empty, emails are written to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Lockred <no-reply@lockred.app>"

# Stripe. Leave STRIPE_SECRET_KEY empty to run without billing (trials never block).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring per-seat prices, created in the Stripe dashboard
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# Trials and affiliates
TRIAL_DAYS=14
TRIAL_SEATS=10
AFFILIATE_COMMISSION_PERCENT=20
AFFILIATE_COMMISSION_MONTHS=12
AFFILIATE_COOKIE_DAYS=60

# Time zone used for demo resets, reports and the backup schedule
TZ=Europe/Stockholm
